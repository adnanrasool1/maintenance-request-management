# Configuration for the local Docker stack.
# Copy to infra/.env with ./setup.sh (or .\setup.ps1 on Windows), which replaces every
# "change-me" value with a random secret. infra/.env is git-ignored; never commit it.
# Values must not contain spaces, quotes, "$", "#" or ";".

# --- SQL Server ---------------------------------------------------------------
# Password of the SQL Server "sa" (owner) login. Used only by SQL Server itself and the migrator.
# Must meet SQL Server complexity rules: upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=change-me
# Password of the restricted "mra_app" login the API connects as (architecture section 8).
MRA_APP_PASSWORD=change-me

# --- Authentication -----------------------------------------------------------
# HMAC key used to sign JWTs. At least 32 random bytes, base64-encoded.
JWT_SIGNING_KEY=change-me
# JWT issuer ("iss") and audience ("aud") claims.
JWT_ISSUER=mra-api
JWT_AUDIENCE=mra-web

# --- Seeded System Admin ------------------------------------------------------
# Credentials of the System Admin that the migrator seeds on first start.
SYSTEM_ADMIN_EMAIL=admin@example.local
SYSTEM_ADMIN_PASSWORD=change-me

# --- Host ports ---------------------------------------------------------------
# Ports published on localhost. Change them if something else already uses them.
SQL_HOST_PORT=1433
API_HOST_PORT=5080
WEB_HOST_PORT=8080
